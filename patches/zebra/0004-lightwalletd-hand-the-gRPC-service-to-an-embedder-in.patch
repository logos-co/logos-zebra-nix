+++ b/zebra-rpc/src/lightwalletd/server.rs
@@ -1,10 +1,14 @@
 //! A tonic gRPC server for the lightwalletd `CompactTxStreamer` client API.
 
-use std::{net::SocketAddr, time::Duration};
+use std::{convert::Infallible, net::SocketAddr, time::Duration};
 
 use tokio::task::JoinHandle;
-use tonic::transport::{server::TcpIncoming, Server};
-use tower::BoxError;
+use tonic::{
+    body::Body,
+    codegen::http,
+    transport::{server::TcpIncoming, Server},
+};
+use tower::{util::BoxCloneService, BoxError};
 use zebra_chain::{chain_tip::ChainTip, parameters::Network};
 use zebra_node_services::mempool::{MempoolService, MempoolTxSubscriber};
 use zebra_state::ReadState;
@@ -31,6 +35,10 @@ const HTTP2_KEEPALIVE_TIMEOUT: Duration = Duration::from_secs(10);
 
 type ServerTask = JoinHandle<Result<(), BoxError>>;
 
+/// The lightwalletd gRPC service with its types erased, for an embedder that serves it
+/// in-process rather than over TCP.
+pub type BoxedService = BoxCloneService<http::Request<Body>, http::Response<Body>, Infallible>;
+
 /// Lightwalletd gRPC service.
 ///
 /// Most methods are implemented by calling Zebra's JSON-RPC methods in-process, in the
@@ -51,6 +59,31 @@ where
     pub(super) network: Network,
 }
 
+/// Builds the lightwalletd gRPC service, for [`init`] or for an embedder to serve itself.
+pub fn service<Rpc, ReadStateService, Mempool, Tip>(
+    rpc: Rpc,
+    read_state: ReadStateService,
+    mempool: Mempool,
+    latest_chain_tip: Tip,
+    mempool_change: MempoolTxSubscriber,
+    network: Network,
+) -> CompactTxStreamerServer<LightwalletdRPC<Rpc, ReadStateService, Mempool, Tip>>
+where
+    Rpc: RpcMethods + Clone,
+    ReadStateService: ReadState,
+    Mempool: MempoolService,
+    Tip: ChainTip + Clone + Send + Sync + 'static,
+{
+    CompactTxStreamerServer::new(LightwalletdRPC {
+        rpc,
+        read_state,
+        mempool,
+        latest_chain_tip,
+        mempool_change,
+        network,
+    })
+}
+
 /// Initializes the lightwalletd gRPC server.
 #[tracing::instrument(skip_all)]
 pub async fn init<Rpc, ReadStateService, Mempool, Tip>(
@@ -68,14 +101,14 @@ where
     Mempool: MempoolService,
     Tip: ChainTip + Clone + Send + Sync + 'static,
 {
-    let lightwalletd_service = LightwalletdRPC {
+    let lightwalletd_service = service(
         rpc,
         read_state,
         mempool,
         latest_chain_tip,
         mempool_change,
         network,
-    };
+    );
 
     let reflection_service = tonic_reflection::server::Builder::configure()
         .register_encoded_file_descriptor_set(crate::lightwalletd::FILE_DESCRIPTOR_SET)
@@ -98,7 +131,7 @@ where
             .http2_keepalive_timeout(Some(HTTP2_KEEPALIVE_TIMEOUT))
             .layer(GrpcTracingLayer)
             .add_service(reflection_service)
-            .add_service(CompactTxStreamerServer::new(lightwalletd_service))
+            .add_service(lightwalletd_service)
             .serve_with_incoming(TcpIncoming::from(tcp_listener))
             .await?;
 
