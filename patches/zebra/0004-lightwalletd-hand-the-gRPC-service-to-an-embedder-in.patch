+/// Receives the lightwalletd gRPC service once the node has built it, so an embedder
+/// can serve it in-process, without a TCP listener.
+pub type LightwalletdServiceSink = Box<dyn FnOnce(lightwalletd::server::BoxedService) + Send>;
+
 /// Warns if Linux TCP slow-start-after-idle is enabled, which significantly
 /// reduces single-peer throughput for block propagation.
 ///
@@ -260,14 +273,21 @@ impl StartCmd {
     }
 
     async fn start(&self) -> Result<(), Report> {
-        Self::run_node(APPLICATION.config(), self.unsafe_low_specs).await
+        Self::run_node(APPLICATION.config(), self.unsafe_low_specs, None).await
     }
 
     /// Runs the node with `config`, without the Abscissa launcher.
     ///
     /// Dropping the returned future stops the node. The caller owns tracing, metrics,
     /// the rayon pool, signal handling and the shutdown flag.
-    pub async fn run_node(config: Arc<ZebradConfig>, unsafe_low_specs: bool) -> Result<(), Report> {
+    ///
+    /// If `lightwalletd_sink` is set, it receives the lightwalletd gRPC service, whether or
+    /// not `rpc.lightwalletd_listen_addr` also serves it over TCP.
+    pub async fn run_node(
+        config: Arc<ZebradConfig>,
+        unsafe_low_specs: bool,
+        lightwalletd_sink: Option<LightwalletdServiceSink>,
+    ) -> Result<(), Report> {
         check_tcp_slow_start_after_idle();
 
         let is_regtest = config.network.network.is_regtest();
@@ -601,6 +621,20 @@ impl StartCmd {
             }
         };
 
+        if let Some(lightwalletd_sink) = lightwalletd_sink {
