+    /// Builds the service [`Self::start`] serves, for an embedder to call in-process.
+    ///
+    /// It has the same methods, limits and RPC middleware, with no listener and no cookie.
+    #[allow(clippy::too_many_arguments)]
+    pub fn in_memory_service<
+        Mempool,
+        State,
+        ReadState,
+        Tip,
+        BlockVerifierRouter,
+        SyncStatus,
+        AddressBook,
+    >(
+        rpc: RpcImpl<Mempool, State, ReadState, Tip, AddressBook, BlockVerifierRouter, SyncStatus>,
+        conf: &config::rpc::Config,
+    ) -> InMemoryService
+    where
+        Mempool: MempoolService,
+        State: StateService,
+        ReadState: ReadStateService,
+        Tip: ChainTip + Clone + Send + Sync + 'static,
+        AddressBook: AddressBookPeers + Clone + Send + Sync + 'static,
+        BlockVerifierRouter: BlockVerifierService,
+        SyncStatus: ChainSyncStatus + Clone + Send + Sync + 'static,
+    {
+        let rpc = rpc.into_rpc();
+        let registered_methods: Arc<HashSet<_>> = Arc::new(rpc.method_names().collect());
+        let traced_methods = registered_methods.clone();
+
+        let rpc_middleware = RpcServiceBuilder::new()
+            .rpc_logger(1024)
+            .layer_fn(FixRpcResponseMiddleware::new)
+            .layer_fn(move |service| RpcMetricsMiddleware::new(service, registered_methods.clone()))
+            .layer_fn(move |service| RpcTracingMiddleware::new(service, traced_methods.clone()));
+
+        let (stop_handle, server_handle) = stop_channel();
+        let service = Server::builder()
+            .http_only()
+            .set_rpc_middleware(rpc_middleware)
+            .max_request_body_size(MAX_REQUEST_BODY_SIZE as u32)
+            .max_response_body_size(conf.max_response_body_size)
+            .to_service_builder()
+            .build(rpc, stop_handle);
+
+        BoxCloneService::new(tower::service_fn(move |request: String| {
+            // The server stops when its last handle drops, so the service keeps one.
+            let _ = &server_handle;
+            let mut service = service.clone();
+            async move {
+                let request = HttpRequest::post("/")
+                    .header(header::CONTENT_TYPE, "application/json")
+                    .body(HttpBody::from(request))?;
+                let response: HttpResponse<HttpBody> = service.call(request).await?;
+                let body = response.into_body().collect().await?.to_bytes();
+                Ok(String::from_utf8(body.to_vec())?)
+            }
+        }))
+    }
+
     /// Shut down this RPC server, blocking the current thread.
     ///
     /// This method can be called from within a tokio executor without panicking.
